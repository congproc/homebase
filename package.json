{
  "name": "homebase",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test \"tests/*.test.mjs\" && python3 -B -m unittest discover -s tests -p \"test_*.py\"",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint app src server scripts",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Homebase — a private dashboard and control panel for a single Linux home server.",
  "license": "MIT",
  "files": [
    "server/",
    "dist/",
    "system/",
    "install.sh",
    "uninstall.sh",
    "config.example.json",
    "README.md"
