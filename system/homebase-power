#!/usr/bin/python3 -I
"""Fixed-purpose, root-owned bridge for Homebase's nightly sleep policy, service control and SMART reads."""
import fcntl
import json
import os
import pathlib
import re
import stat
import subprocess
import sys
import tempfile
import time

CONFIG = pathlib.Path('/etc/homebase/power.json')
DROPIN = pathlib.Path('/etc/systemd/system/server-night-sleep.timer.d/homebase.conf')
# Root-only directory (not the world-writable /run/lock): other accounts can neither pre-create nor hold it.
LOCK = pathlib.Path('/run/homebase-power.lock')
OWNER_FILE = pathlib.Path('/etc/homebase/owner')

def owner():
    """The account Homebase runs as, recorded by the installer (root-owned file)."""
    import pwd
    name = OWNER_FILE.read_text().strip()
    if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', name):
        raise ValueError('Invalid owner in ' + str(OWNER_FILE))
    entry = pwd.getpwnam(name)
    return entry.pw_name, entry.pw_uid
DEFAULT = {'enabled': True, 'sleepTime': '00:30', 'wakeTime': '05:00', 'blockSsh': True, 'blockTmux': True, 'services': {}}
UNIT = re.compile(r'(user|system):([A-Za-z0-9][A-Za-z0-9_.-]*\.service)\Z')
TIME = re.compile(r'(?:[01]\d|2[0-3]):[0-5]\d\Z')

def validate(value):
    if not isinstance(value, dict) or set(value) != set(DEFAULT):
        raise ValueError('Unexpected settings fields')
    for key in ('enabled', 'blockSsh', 'blockTmux'):
        if type(value[key]) is not bool:
            raise ValueError(key + ' must be a boolean')
    for key in ('sleepTime', 'wakeTime'):
        if not isinstance(value[key], str) or not TIME.fullmatch(value[key]):
            raise ValueError('Use HH:MM for ' + key)
    if value['sleepTime'] == value['wakeTime']:
        raise ValueError('Sleep and wake times must differ')
    if not isinstance(value['services'], dict) or len(value['services']) > 100:
        raise ValueError('Invalid service preferences')
    for key, flag in value['services'].items():
        if not UNIT.fullmatch(key) or type(flag) is not bool:
            raise ValueError('Invalid service preference')
    return value

def read_config():
    return validate(json.loads(CONFIG.read_text()))

def run(args, check=True):
    return subprocess.run(args, text=True, capture_output=True, timeout=15, check=check)

def systemctl(scope, *args):
    if scope == 'user':
        if os.geteuid() == 0:
            user, uid = owner()
            prefix = ['/usr/sbin/runuser', '-u', user, '--', '/usr/bin/env', f'XDG_RUNTIME_DIR=/run/user/{uid}', f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus', '/usr/bin/systemctl', '--user']
        else:
            prefix = ['/usr/bin/systemctl', '--user']
    else:
        prefix = ['/usr/bin/systemctl']
    return run(prefix + list(args), check=False)

def service_blockers(config):
    blockers = []
    for key, selected in config['services'].items():
        if not selected:
            continue
        scope, unit = UNIT.fullmatch(key).groups()
        result = systemctl(scope, 'show', '--property=ActiveState', '--value', '--', unit)
        state = result.stdout.strip()
        if result.returncode or not state:
            blockers.append(f'Unable to check selected service: {key}')
        elif state in ('active', 'activating', 'reloading', 'deactivating'):
            blockers.append(f'Service prevents sleep: {key} ({state})')
    return blockers

def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.homebase-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(name, 0o644)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)

def acquire_lock(timeout=10.0):
    """Exclusive apply lock: root-owned regular 0600 file, never a link, bounded wait."""
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        os.close(fd)
        raise ValueError('Unsafe lock file: ' + str(LOCK))
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return os.fdopen(fd, 'r+')
        except BlockingIOError:
            if time.monotonic() > deadline:
                os.close(fd)
                raise ValueError('Another sleep-settings update is in progress; try again shortly')
            time.sleep(0.2)

def apply(config):
    validate(config)
    if os.geteuid() != 0:
        raise ValueError('Installation requires administrator privileges')
    # Serialize dashboard saves. Never execute service names or user input as shell code.
    with acquire_lock():
        previous = CONFIG.read_text() if CONFIG.exists() else None
        old_dropin = DROPIN.read_text() if DROPIN.exists() else None
        old_enabled = systemctl('system', 'is-enabled', 'server-night-sleep.timer').stdout.strip() == 'enabled'
        try:
            for key, selected in config['services'].items():
                if not selected:
                    continue
                scope, unit = UNIT.fullmatch(key).groups()
                result = systemctl(scope, 'show', '--property=LoadState', '--value', '--', unit)
                if result.returncode or result.stdout.strip() not in ('loaded', 'masked'):
                    raise ValueError('Unknown service: ' + key)
            atomic_write(CONFIG, json.dumps(config, indent=2) + '\n')
            atomic_write(DROPIN, f'[Timer]\nOnCalendar=\nOnCalendar=*-*-* {config["sleepTime"]}:00\n')
            run(['/usr/bin/systemctl', 'daemon-reload'])
            run(['/usr/bin/systemctl', 'enable' if config['enabled'] else 'disable', 'server-night-sleep.timer'])
            run(['/usr/bin/systemctl', 'restart' if config['enabled'] else 'stop', 'server-night-sleep.timer'])
        except Exception:
            if previous is not None:
                atomic_write(CONFIG, previous)
            elif CONFIG.exists():
                CONFIG.unlink()
            if old_dropin is not None:
                atomic_write(DROPIN, old_dropin)
            elif DROPIN.exists():
                DROPIN.unlink()
            run(['/usr/bin/systemctl', 'daemon-reload'], check=False)
            run(['/usr/bin/systemctl', 'enable' if old_enabled else 'disable', 'server-night-sleep.timer'], check=False)
            run(['/usr/bin/systemctl', 'restart' if old_enabled else 'stop', 'server-night-sleep.timer'], check=False)
            raise
    return config

SYSTEM_UNITS = pathlib.Path('/etc/systemd/system')
SERVICE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]*\.service\Z')
SERVICE_ACTIONS = ('start', 'stop', 'restart')

def control_service(action, unit):
    """Start/stop/restart one custom system service shown in Homebase."""
    if action not in SERVICE_ACTIONS:
        raise ValueError('Unsupported service action')
    if not SERVICE_NAME.fullmatch(unit) or unit.startswith(('server-night-sleep', 'snap.')):
        raise ValueError('Invalid service name')
    # Only regular unit files placed directly in /etc/systemd/system (same set Homebase lists).
    path = SYSTEM_UNITS / unit
    if path.is_symlink() or not path.is_file():
        raise ValueError('Only custom system services can be controlled')
    if os.geteuid() != 0:
        raise ValueError('Service control requires administrator privileges')
    result = subprocess.run(['/usr/bin/systemctl', action, '--', unit], text=True, capture_output=True, timeout=40)
    if result.returncode:
        raise ValueError(result.stderr.strip() or f'systemctl {action} failed')
    return 0

DISK_NAME = re.compile(r'(sd[a-z]{1,3}|nvme\d{1,3}n\d{1,3}|vd[a-z]{1,3}|hd[a-z]|mmcblk\d{1,3})\Z')
SMARTCTL = ('/usr/sbin/smartctl', '/usr/bin/smartctl')
STANDBY = 99
ATA_KEEP = {5, 9, 12, 177, 187, 188, 194, 196, 197, 198, 199, 202, 231, 233, 241, 242}

def smart_summary(data):
    """The small, fixed subset of smartctl's JSON that Homebase shows."""
    pick = lambda d, *keys: {k: d[k] for k in keys if isinstance(d, dict) and k in d}
    out = {
        'passed': data.get('smart_status', {}).get('passed'),
        'temperature': data.get('temperature', {}).get('current'),
        'powerOnHours': data.get('power_on_time', {}).get('hours'),
        'powerCycles': data.get('power_cycle_count'),
        'rotationRate': data.get('rotation_rate'),
        'formFactor': data.get('form_factor', {}).get('name'),
        'interfaceSpeed': data.get('interface_speed', {}).get('current', {}).get('string'),
        'firmware': data.get('firmware_version'),
    }
    nvme = data.get('nvme_smart_health_information_log')
    if isinstance(nvme, dict):
        out['nvme'] = pick(nvme, 'critical_warning', 'percentage_used', 'available_spare', 'available_spare_threshold', 'media_errors',
                           'num_err_log_entries', 'unsafe_shutdowns', 'data_units_read', 'data_units_written')
    table = data.get('ata_smart_attributes', {}).get('table')
    if isinstance(table, list):
        out['ata'] = [{'id': a.get('id'), 'name': a.get('name'), 'value': a.get('value'), 'worst': a.get('worst'), 'thresh': a.get('thresh'),
                       'raw': a.get('raw', {}).get('value'), 'failing': a.get('when_failed') or None}
                      for a in table if isinstance(a, dict) and a.get('id') in ATA_KEEP]
    return {k: v for k, v in out.items() if v is not None}

def smart(name):
    """Read-only SMART health for one whole disk; never wakes a drive that is spun down."""
    if not DISK_NAME.fullmatch(name) or not pathlib.Path('/sys/block', name).is_dir():
        raise ValueError('Unknown disk')
    tool = next((p for p in SMARTCTL if os.path.isfile(p)), None)
    if tool is None:
        return {'error': 'not-installed'}
    if os.geteuid() != 0:
        raise ValueError('SMART requires administrator privileges')
    result = subprocess.run([tool, '--json', '-n', f'standby,{STANDBY}', '-i', '-H', '-A', '/dev/' + name], text=True, capture_output=True, timeout=30)
    if result.returncode == STANDBY:
        return {'standby': True}
    try:
        data = json.loads(result.stdout)
    except ValueError:
        return {'error': 'unreadable'}
    # Bits 0-1: command line or device open failed. Other bits describe the drive and still carry data.
    if result.returncode & 3:
        messages = [m.get('string', '') for m in data.get('smartctl', {}).get('messages', []) if isinstance(m, dict)]
        return {'error': (messages[0] if messages else 'smartctl failed')[:200]}
    return smart_summary(data)

def main():
    if len(sys.argv) < 2:
        raise ValueError('Missing operation')
    command = sys.argv[1]
    if command == 'apply' and len(sys.argv) == 2:
        raw = sys.stdin.read(32769)
        if len(raw) > 32768:
            raise ValueError('Settings too large')
        print(json.dumps(apply(validate(json.loads(raw)))))
    elif command == 'validate' and len(sys.argv) == 2:
        print(json.dumps(validate(json.load(sys.stdin))))
    elif command == 'check-services' and len(sys.argv) == 2:
        blockers = service_blockers(read_config())
        for reason in blockers:
            print(reason)
        return 1 if blockers else 0
    elif command == 'service' and len(sys.argv) == 4:
        return control_service(sys.argv[2], sys.argv[3])
    elif command == 'smart' and len(sys.argv) == 3:
        print(json.dumps(smart(sys.argv[2])))
    elif command == 'wake-time' and len(sys.argv) == 2:
        print(read_config()['wakeTime'])
    elif command == 'flag' and len(sys.argv) == 3 and sys.argv[2] in ('blockSsh', 'blockTmux'):
        return 0 if read_config()[sys.argv[2]] else 1
    else:
        raise ValueError('Unsupported operation')
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as error:
        print(str(error), file=sys.stderr)
        # An unreadable policy must not silently permit suspend.
        sys.exit(2)
